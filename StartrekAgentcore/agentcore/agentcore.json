{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "StartrekAgentcore",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "StartrekAgentcore"
  },
  "runtimes": [
    {
      "name": "DataRAGAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/DataRAGAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "DataRAGAgentMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}"
          ]
        },
        {
          "type": "EPISODIC",
          "namespaceTemplates": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaceTemplates": [
            "/episodes/{actorId}"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "StarTrekGateway",
      "protocolType": "None",
      "description": "Gateway for StarTrekGateway",
      "targets": [
        {
          "name": "LieutenantCommanderData",
          "targetType": "connector",
          "connectorId": "bedrock-knowledge-bases",
          "configurations": [
            {
              "name": "AgenticRetrieveStream",
              "description": "Streaming endpoint for agentic retrieval from knowledge bases. Performs multi-step retrieval with planning and returns results as a stream of events.",
              "parameterValues": {
                "retrievers": [
                  {
                    "configuration": {
                      "knowledgeBase": {
                        "knowledgeBaseId": "YVCCPJU5EN"
                      }
                    }
                  }
                ],
                "agenticRetrieveConfiguration": {
                  "foundationModelType": "MANAGED",
                  "rerankingModelType": "MANAGED"
                }
              },
              "parameterOverrides": []
            },
            {
              "name": "Retrieve",
              "description": "Queries a knowledge base and retrieves information from it.",
              "parameterValues": {
                "knowledgeBaseId": "YVCCPJU5EN"
              },
              "parameterOverrides": []
            }
          ]
        }
      ],
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE",
      "policyEngineConfiguration": {
        "policyEngineName": "StarTrekPolicy",
        "mode": "LOG_ONLY"
      }
    }
  ],
  "policyEngines": [
    {
      "name": "StarTrekPolicy",
      "policies": [
        {
          "name": "PermitStarTrekRetrieval",
          "statement": "permit(\r\n    principal is AgentCore::IamEntity,\r\n    action in [\r\n        AgentCore::Action::\"LieutenantCommanderData___Retrieve\",\r\n        AgentCore::Action::\"LieutenantCommanderData___AgenticRetrieveStream\"\r\n    ],\r\n    resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:us-east-1:339712939282:gateway/startrekagentcore-startrekgateway-321spmaima\"\r\n);",
          "sourceFile": "permit-retrieval.cedar",
          "validationMode": "FAIL_ON_ANY_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        },
        {
          "name": "DenyStarTrekRetrieval",
          "statement": "forbid(\r\n    principal is AgentCore::IamEntity,\r\n    action == AgentCore::Action::\"LieutenantCommanderData___AgenticRetrieveStream\",\r\n    resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:us-east-1:339712939282:gateway/startrekagentcore-startrekgateway-321spmaima\"\r\n)\r\nwhen {\r\n    principal.id like \"arn:aws:sts::339712939282:assumed-role/*\"\r\n};",
          "sourceFile": "deny-retrieval.cedar",
          "validationMode": "FAIL_ON_ANY_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        }
      ]
    }
  ],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}